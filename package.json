{
  "name": "@brava-apps/blits-animation-plugin",
  "version": "1.4.1",
  "description": "Animation plugin for Blits",
  "author": "BravaApps <hi@bravaapps.com>",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "prepare": "npm run build:types",
    "docs:examples:install": "npm install --prefix docs/examples/basic",
    "docs:examples:build": "npm run build --prefix docs/examples/basic"
  },
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./declarations/index.d.ts",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./src/index.js"
    },
    "./frame-tick": {
      "types": "./declarations/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "declarations",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@lightningjs/blits": "^2.10.0"
  },
  "keywords": [
    "blits",
    "lightning",
    "animation",
    "plugin",
    "timeline",
    "sequence"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
